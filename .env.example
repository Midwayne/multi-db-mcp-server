# Pass these through the MCP client's "env" block, or export them in your shell
# before running ./dbmcp. The spec file should reference them as ${MONGO_URI}.

MONGO_URI=mongodb://localhost:27017
POSTGRES_URI=postgres://postgres:postgres@localhost:5432/app?sslmode=disable
REDIS_URI=redis://localhost:6379/0

# Optional. If set, you can omit -spec.
# DBMCP_SPEC=/absolute/path/to/spec.yaml
