# GOPROXY configuration
GOPROXY="https://proxy.golang.org,direct"

# Comma-separated list of tools to enable
TOOLS="connect,find,aggregate,count,list-databases,list-collections,collection-indexes,collection-schema,collection-storage-size,db-stats"

# MongoDB connection URIs
# Add as many MONGO_CONN* variables as you need
MONGO_CONN_1="mongodb://localhost:27017"
MONGO_CONN_2="mongodb://another-host:27017"
